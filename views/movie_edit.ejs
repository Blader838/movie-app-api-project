<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit Movie</title>
</head>
<body>
  <h1>Edit Movie</h1>
  <form action="/movies/<%= movie.movie_id %>?_method=PATCH" method="POST">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" value="<%= movie.title %>" required><br>
    <label for="rating">Rating:</label>
    <select id="rating" name="rating">
      <option value="G" <%= movie.rating === 'G' ? 'selected' : '' %>>G</option>
      <option value="PG" <%= movie.rating === 'PG' ? 'selected' : '' %>>PG</option>
      <option value="PG-13" <%= movie.rating === 'PG-13' ? 'selected' : '' %>>PG-13</option>
      <option value="R" <%= movie.rating === 'R' ? 'selected' : '' %>>R</option>
      <option value="NC-17" <%= movie.rating === 'NC-17' ? 'selected' : '' %>>NC-17</option>
      <option value="NR" <%= movie.rating === 'NR' ? 'selected' : '' %>>NR</option>
    </select><br>
    <label for="runtime">Runtime (e.g., 1:30:00):</label>
    <input type="text" id="runtime" name="runtime" value="<%= movie.runtime %>"><br>
    <label for="nationality">Nationality (3-letter code):</label>
    <input type="text" id="nationality" name="nationality" value="<%= movie.nationality %>" maxlength="3"><br>
    <label for="yr_released">Year Released:</label>
    <input type="number" id="yr_released" name="yr_released" value="<%= movie.yr_released %>"><br>
    <label for="budget">Budget:</label>
    <input type="number" id="budget" name="budget" value="<%= movie.budget %>"><br>
    <label for="gross">Gross:</label>
    <input type="number" id="gross" name="gross" value="<%= movie.gross %>"><br>
    <label for="production_id">Production:</label>
    <select id="production_id" name="production_id">
      <% productions.forEach(p => { %>
        <option value="<%= p.production_id %>" <%= p.production_id === movie.production_id ? 'selected' : '' %>><%= p.production %></option>
      <% }) %>
    </select><br>
    <label for="showing">Showing:</label>
    <select id="showing" name="showing">
      <option value="theater" <%= movie.showing === 'theater' ? 'selected' : '' %>>theater</option>
      <option value="direct-to-tv" <%= movie.showing === 'direct-to-tv' ? 'selected' : '' %>>direct-to-tv</option>
    </select><br>
    <label for="poster">Poster URL:</label>
    <input type="text" id="poster" name="poster" value="<%= movie.poster %>"><br>
    <button type="submit">Update</button>
  </form>
</body>
</html>